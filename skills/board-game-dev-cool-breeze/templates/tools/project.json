          {
            "name": "thumb",
            "w": 240,
            "h": 180,
            "budget": 10240
          }
        ]
      },
      "token": {
        "gen": "1024x1024",
        "sizes": [
          {
            "name": "main",
            "w": 192,
            "h": 192,
            "budget": 12288
          }
        ]
      }
    }
  }
}
